# =====================================================================
# TEMPLATE KONFIGURASI VARIABEL LINGKUNGAN (.env.example)
# Salin berkas ini ke .env dan isi dengan nilai asli Anda.
# JANGAN PERNAH commit berkas .env asli Anda ke Git!
# =====================================================================

# Konfigurasi Basis Data PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commodity_monitor
DB_USER=postgres
DB_PASSWORD=postgres_password_here

# Token Rahasia Internal untuk Pembersihan Cache (Scraper -> Server)
X_INTERNAL_TOKEN=super-secret-internal-token-2026-custom

# Konfigurasi Notifikasi Telegram Bot
TELEGRAM_BOT_TOKEN=bot_token_here
TELEGRAM_CHAT_ID=chat_id_here

# Konfigurasi Server FastAPI
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_here@localhost:5432/commodity_monitor
